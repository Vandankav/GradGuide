{
  "name": "ai-travel-guide",
  "version": "1.0.0",
  "description": "AI-powered personalized travel guide with itinerary builder and suggested trips",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
